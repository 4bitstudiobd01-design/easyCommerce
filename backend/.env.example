# EasyCommerce Backend Environment Variables Example

# Server Configuration
PORT=5001

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT Secrets
JWT_SECRET=easycommerce_dev_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
