# BitCommerce Backend Environment Variables Example

# Server Configuration
PORT=5001

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=easyComerz

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT Secrets
JWT_SECRET=bitcommerce_dev_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@bitcommerce.com
SUPER_ADMIN_PASSWORD=change_me_in_production

# Platform SMTP (used to email SUPER_ADMIN_EMAIL when a "Contact Us" message is submitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# FraudBD (courier fraud/delivery-history checks by phone number) — https://fraudbd.com/api-documentation
FRAUDBD_API_KEY=
FRAUDBD_BASE_URL=https://fraudbd.com

# ── Courier integrations ─────────────────────────────────────────────
# Per-merchant credentials are entered in the dashboard (Couriers tab) and
# stored encrypted. These env vars are an optional single-tenant / dev
# fallback used only when a merchant has not connected the provider.
# The Couriers-tab "Sandbox" toggle points each adapter at its sandbox host.

# Encrypts stored courier credentials at rest (falls back to JWT_SECRET if unset).
CREDENTIALS_ENCRYPTION_KEY=

# Pathao — https://merchant.pathao.com  (sandbox: courier-api-sandbox.pathao.com)
# PATHAO_BASE_URL overrides the host entirely; leave blank to use the sandbox toggle.
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# Webhooks are NOT wired yet (see pathao.adapter.ts header + docs/integrations/pathao-webhook-todo.md).
# Merchant-generated secret registered on Pathao's Webhook Integration page — used to verify
# the X-PATHAO-Signature header. NOT the literal handshake header value, which is Pathao's own.
PATHAO_WEBHOOK_SECRET=

# Steadfast — https://steadfast.com.bd  (single host; no separate sandbox)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# RedX — https://redx.com.bd  (REDX_BASE_URL overrides the sandbox toggle)
REDX_BASE_URL=
REDX_ACCESS_TOKEN=
REDX_STORE_ID=
# Webhooks are NOT wired yet (see redx.adapter.ts header + docs/integrations/redx-webhook-todo.md).
# RedX has no signature header — this token is embedded in the callback URL's own query string,
# which is the ONLY auth check RedX supports for webhooks.
REDX_WEBHOOK_TOKEN=

# CarryBee — https://merchant.carrybee.com  (sandbox: sandbox.carrybee.com, prod: developers.carrybee.com)
# CARRYBEE_BASE_URL overrides the host; leave blank to use the Couriers-tab sandbox toggle.
CARRYBEE_BASE_URL=
CARRYBEE_CLIENT_ID=
CARRYBEE_CLIENT_SECRET=
CARRYBEE_CLIENT_CONTEXT=
CARRYBEE_STORE_ID=
# Webhooks are NOT wired yet (see carrybee.adapter.ts header + CARRYBEE_INTEGRATION.md §7).
# Stubbed here so the shape is ready when that slice is built.
CARRYBEE_WEBHOOK_INTEGRATION_SECRET=
CARRYBEE_WEBHOOK_SIGNING_SECRET=

# Paperfly — https://go.paperfly.com.bd/merchant  (single host; no separate sandbox/production)
# Basic Auth uses the merchant's real Paperfly Merchant Panel login, not an issued API key.
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_STORE_NAME=
# Fixed platform-wide header value from Paperfly's own docs; override only if Paperfly rotates it.
PAPERFLY_KEY=
# Webhooks are NOT wired yet (see paperfly.adapter.ts header + docs/integrations/paperfly-webhook-todo.md).
# The exact header name this secret arrives in is UNKNOWN — Paperfly's own docs don't state it.
# Confirm via a real test webhook or Paperfly support before relying on this.
PAPERFLY_WEBHOOK_SECRET=
