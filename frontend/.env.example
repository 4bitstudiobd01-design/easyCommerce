# BitCommerce Frontend Environment Variables Example

# Backend REST API Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:5001/v1/auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev/staging only: shows a "Log in as Merchant" switcher on the login page for testing
# merchant-facing work (e.g. HRMS) without a password. The backend independently
# hard-disables the endpoints this calls when NODE_ENV=production, so leaving this
# unset/false is safe by default. NEVER set to true in a production environment.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
